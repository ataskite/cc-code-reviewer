  "upstream_manifest_sha256": "44601e08b8d9a036b9cea822aa57dd22757119b284874cedbf6f0cf5a9f6baea",
  "notes_zh": "Node/BFF 安全控制唯一提交态事实来源。标准映射 ID 全部在 references/security/upstream 本地快照中核验存在，无占位 ID。ID 一经发布不可复用或改义；人类可读说明见 references/security/control-catalog.md。",
  "controls": [
    {
      "id": "CCR-NODE-BFFHEADER-001",
      "title_zh": "客户端请求头批量透传到上游服务",
      "category": "identity",
      "profiles": ["node-bff"],
      "applicability": {
        "review_signals": ["outbound-http-client"],
        "excludes_project_types": []
      },
      "standards": {
        "owasp_top10": ["A07:2025"],
        "owasp_api_top10": ["API2:2023"],
        "asvs": ["v5.0.0-V4.1.3"],
        "cwe": ["CWE-290"]
      },
      "detectability": {
        "primary": "taint",
        "requires_semantic_review": true,
        "runtime_verification_possible": true
      },
      "sources": ["request.headers", "request.body"],
      "sinks": ["http-client-headers", "proxy-request"],
      "required_controls": ["explicit-header-allowlist", "strip-hop-by-hop", "identity-header-regeneration"],
      "required_evidence": ["entry", "source", "propagation", "sink", "missing_control"],
      "severity_candidate": "P0",
      "description_zh": "BFF/网关层把客户端可控请求头（含 Authorization、X-User-Id、X-Tenant-Id、Cookie 等身份头）原样或浅拷贝后整体转发给上游内部服务。上游若信任这些头作为身份来源，客户端可直接伪造任意身份/租户（IMA 事故形态）。",
      "remediation_zh": "按显式白名单逐头构造上游请求；转发前剥离 hop-by-hop 头与客户端可控身份头；身份头必须由 BFF 侧认证结果重新生成（服务端派生），不透传客户端值；无法确认上游是否消费身份头时列为待确认并给出最小验证方式（构造伪造头请求观察上游行为）。"
    },
    {
      "id": "CCR-NODE-IDENTITY-001",
      "title_zh": "客户端字段覆盖服务端身份或租户上下文",
      "category": "identity",
      "profiles": ["node-api", "node-bff"],
      "applicability": {
        "review_signals": ["request-source"],
        "excludes_project_types": []
      },
      "standards": {
        "owasp_top10": ["A01:2025", "A07:2025"],
        "owasp_api_top10": ["API3:2023"],
        "asvs": ["v5.0.0-V4.1.3", "v5.0.0-V8.4.1"],
        "cwe": ["CWE-285"]
      },
      "detectability": {
        "primary": "taint",
        "requires_semantic_review": true,
        "runtime_verification_possible": true
      },
      "sources": ["request.body", "request.query", "request.headers"],
      "sinks": ["identity-context", "tenant-context", "session-claims"],
      "required_controls": ["server-derived-identity", "tenant-from-trusted-source", "client-override-denied"],
      "required_evidence": ["entry", "source", "propagation", "sink", "missing_control"],
      "severity_candidate": "P0",
      "description_zh": "请求体/查询/header 中的 userId、tenantId、orgId、role、isAdmin 等字段被直接用于构造服务端身份或租户上下文（例如 ctx.user = req.body.user），客户端可覆盖任意主体实现跨租户/提权。",
      "remediation_zh": "身份与租户字段只允许来自服务端可信来源（session、JWT 校验结果、网关注入并剥离客户端同名字段）；对进入业务逻辑的请求对象做字段白名单剥离；构造差分用例验证客户端覆盖不生效。"
    },
    {
      "id": "CCR-NODE-SESSION-001",
      "title_zh": "请求对象批量写入 Session（mass assignment）",
      "category": "authorization",
      "profiles": ["node-api", "node-bff"],
      "applicability": {
        "review_signals": ["session-usage"],
        "excludes_project_types": []
      },
      "standards": {
        "owasp_top10": ["A08:2025"],
        "owasp_api_top10": ["API3:2023"],
        "asvs": ["v5.0.0-V8.2.3"],
        "cwe": ["CWE-915"]
      },
      "detectability": {
        "primary": "pattern",
        "requires_semantic_review": true,
        "runtime_verification_possible": false
      },
      "sources": ["request.body"],
      "sinks": ["session-write"],
      "required_controls": ["field-allowlist", "schema-validation"],
      "required_evidence": ["entry", "source", "sink", "missing_control"],
      "severity_candidate": "P1",
      "description_zh": "把 req.body 整体（或 for-in 逐键）写入 req.session（如 req.session = req.body、req.session[x] = req.body[x]），攻击者可注入 isAdmin、role、userId、tenantId 等任意会话字段实现提权或跨租户。",
      "remediation_zh": "会话字段逐字段显式赋值且来源服务端可信；必须写入用户可控字段时使用 schema（joi/zod/ajv）+ 字段白名单收敛；对既有会话迁移时先剥离权限类字段。"
    },
    {
      "id": "CCR-NODE-SSRF-001",
      "title_zh": "用户可控数据进入服务端外发请求目标",
      "category": "external-resource",
      "profiles": ["node-api", "node-bff"],
      "applicability": {
        "review_signals": ["outbound-http-client"],
        "excludes_project_types": []
      },
      "standards": {
        "owasp_top10": ["A01:2025"],
        "owasp_api_top10": ["API7:2023", "API10:2023"],
        "asvs": ["v5.0.0-V1.3.6"],
        "cwe": ["CWE-918"]
      },
      "detectability": {
        "primary": "taint",
        "requires_semantic_review": true,
        "runtime_verification_possible": true
      },
      "sources": ["request.body", "request.query", "request.params", "request.headers"],
      "sinks": ["fetch", "axios", "got", "http.request", "https.request"],
      "required_controls": ["scheme_allowlist", "resolved_host_allowlist", "redirect_revalidation"],
      "required_evidence": ["entry", "source", "propagation", "sink", "missing_control"],
      "severity_candidate": "P0",
      "description_zh": "用户可控的 URL/Host/Path/重定向目标未经协议、域名/IP 白名单校验直接进入服务端外发请求，可探测内网、云元数据端点（169.254.169.254）或经 302 重定向绕过校验（v1.7.1 已有真实事故负面清单）。",
      "remediation_zh": "对完整 URL 解析后校验 scheme 白名单（http/https）；校验解析后的真实 IP（含 DNS 解析结果）属于出口白名单；关闭或复验重定向（maxRedirects=0 或每跳重新校验）；拒绝 literal IP 与内网/链路本地网段；私网解析结果拒绝。"
    },
    {
      "id": "CCR-NODE-CMD-001",
      "title_zh": "用户输入进入 child_process 命令执行",
      "category": "injection",
      "profiles": ["node-api", "node-bff", "node-worker"],
      "applicability": {
        "review_signals": ["child-process"],
        "excludes_project_types": []
      },
      "standards": {
        "owasp_top10": ["A05:2025"],
        "owasp_api_top10": ["API10:2023"],
        "asvs": ["v5.0.0-V1.2.5"],
        "cwe": ["CWE-78"]
      },
      "detectability": {
        "primary": "pattern",
        "requires_semantic_review": false,
        "runtime_verification_possible": false
      },
      "sources": ["request.body", "request.query", "request.params", "message.payload"],
      "sinks": ["child_process.exec", "child_process.execSync", "child_process.spawn(shell:true)"],
      "required_controls": ["execFile-array-args", "no-shell-concat", "argv-allowlist"],
      "required_evidence": ["entry", "source", "propagation", "sink", "missing_control"],
      "severity_candidate": "P0",
      "description_zh": "用户输入经字符串拼接进入 exec/execSync/spawn(shell:true) 的 shell 命令行（;、$()、反引号即可逃逸），导致任意命令执行。",
      "remediation_zh": "改用 execFile/execFileSync 并以数组传参（不经 shell）；命令名与参数白名单化；确需 shell 时对输入做严格转义并评估必要性；证据闭合的命令注入按注入直通定级 P0。"
    },
    {
      "id": "CCR-NODE-PATH-001",
      "title_zh": "用户输入进入文件读取/下载路径",
      "category": "file",
      "profiles": ["node-api", "node-bff"],
      "applicability": {
        "review_signals": ["fs-path-ops"],
        "excludes_project_types": []
      },
      "standards": {
        "owasp_top10": ["A01:2025"],
        "owasp_api_top10": ["API8:2023"],
        "asvs": ["v5.0.0-V5.3.2", "v5.0.0-V5.4.1"],
        "cwe": ["CWE-22"]
      },
      "detectability": {
        "primary": "taint",
        "requires_semantic_review": false,
        "runtime_verification_possible": false
