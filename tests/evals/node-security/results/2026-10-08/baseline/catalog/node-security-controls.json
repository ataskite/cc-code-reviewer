      "sources": ["request.params", "request.query", "request.body"],
      "sinks": ["fs.readFile", "res.sendFile", "res.download", "fs.createReadStream"],
      "required_controls": ["path.resolve-root-check", "basename-normalization", "allowlist-dir"],
      "required_evidence": ["entry", "source", "propagation", "sink", "missing_control"],
      "severity_candidate": "P0",
      "description_zh": "用户可控文件名/路径拼接进 fs 读取或 sendFile/download 响应，../ 序列穿越根目录读取任意文件；path.join 只做拼接并不会中和 ../。",
      "remediation_zh": "path.resolve 到根目录后校验结果仍以根前缀开头（含边界分隔符）；文件名先取 basename 剥离目录段；目录白名单限定；下载响应校验最终绝对路径。证据闭合的根逃逸路径穿越定级 P0。"
    },
    {
      "id": "CCR-NODE-PROTO-001",
      "title_zh": "原型污染危险键进入深合并",
      "category": "injection",
      "profiles": ["node-api", "node-bff"],
      "applicability": {
        "review_signals": ["deep-merge"],
        "excludes_project_types": []
      },
      "standards": {
        "owasp_top10": ["A05:2025"],
        "owasp_api_top10": ["API3:2023"],
        "asvs": ["v5.0.0-V1.3.3"],
        "cwe": ["CWE-1321"]
      },
      "detectability": {
        "primary": "pattern",
        "requires_semantic_review": false,
        "runtime_verification_possible": false
      },
      "sources": ["request.body", "request.query", "json-payload"],
      "sinks": ["deep-merge", "recursive-object-assign", "lodash-merge"],
      "required_controls": ["proto-key-filter", "schema-validation", "safe-clone"],
      "required_evidence": ["entry", "source", "propagation", "sink", "missing_control"],
      "severity_candidate": "P0",
      "description_zh": "req.body/解析后的 JSON 进入递归合并/extend/defaults，__proto__、constructor.prototype 键沿原型链写入 Object.prototype，污染全局对象后可升级为 RCE 或鉴权绕过（污染 isAdmin 等）。",
      "remediation_zh": "合并前递归剥离 __proto__/constructor.prototype 键；用 Object.create(null) 或 Map 承载不可信对象；升级修复过原型污染的 lodash/merge 实现；入参先过 schema 校验。"
    },
    {
      "id": "CCR-NODE-NOSQL-001",
      "title_zh": "未过滤对象进入 NoSQL 查询",
      "category": "injection",
      "profiles": ["node-api", "node-bff"],
