        "requires_semantic_review": true,
        "runtime_verification_possible": false
      },
      "sources": ["cookie-session", "browser-origin"],
      "sinks": ["state-changing-endpoint"],
      "required_controls": ["csrf-token", "sameSite-cookie", "origin-check"],
      "required_evidence": ["entry", "auth-mode", "state-change", "missing_control"],
      "severity_candidate": "P1",
      "description_zh": "依赖 Cookie 会话认证的状态变更接口（写/删/配置）缺少 CSRF token 或 SameSite 防护，第三方站点可携浏览器凭据触发跨站写操作。纯 Bearer header 认证且证据可见时豁免（须给出证据）。",
      "remediation_zh": "写接口启用 CSRF token（csurf/双提交）或校验 Origin/Sec-Fetch-Site；会话 Cookie 设置 SameSite=Lax/Strict；认证方式为纯 Bearer 头时在控制台账写明豁免证据而非默认豁免。"
    }
  ]
}
